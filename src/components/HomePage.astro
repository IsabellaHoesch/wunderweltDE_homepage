---
import { Picture } from 'astro:assets';
import type { HomeContent } from '../data/homeContent';
import SiteHeader from './SiteHeader.astro';
import heroImage from '../assets/hero-family-reading.png';
import butterflyImage from '../../assets/dec_butterfly.png';
import twigImage from '../../assets/dec_twig.png';
import reviewAnnabelPapaImage from '../assets/review-annabel-papa.jpg';
import reviewBrombeerPapaImage from '../assets/review-brombeer-papa.jpg';
import reviewSarahKoalaImage from '../assets/review-sarah-koala.jpg';
import reviewSvenjaPapaImage from '../assets/review-svenja-papa.jpg';
import bestseller1Image from '../assets/bestsellers/bestseller-1.png';
import bestseller2Image from '../assets/bestsellers/bestseller-2.png';
import bestseller3Image from '../assets/bestsellers/bestseller-3.png';
import bestseller4Image from '../assets/bestsellers/bestseller-4.png';
import bestseller5Image from '../assets/bestsellers/bestseller-5.png';
import logoShort from '../../assets/Etsy logo (2)/logo_short.png';
import bookOpenIcon from 'lucide-static/icons/book-open.svg?raw';
import giftIcon from 'lucide-static/icons/gift.svg?raw';
import instagramIcon from 'lucide-static/icons/instagram.svg?raw';
import penLineIcon from 'lucide-static/icons/pen-line.svg?raw';

interface Props {
  content: HomeContent;
  currentLocale: 'en' | 'de';
  alternateLocaleHref: string;
}

const { content, currentLocale, alternateLocaleHref } = Astro.props;
const shopHref = 'https://www.etsy.com/de/shop/WunderweltKidsDE';
const reviewsHref = 'https://www.etsy.com/de/shop/WunderweltKidsDE#reviews';
const instagramHref = 'https://www.instagram.com/wunderwelt.kids/';
const reviewStarsLabel = currentLocale === 'de' ? '5 von 5 Sternen' : '5 out of 5 stars';
const reviewImages = {
  annabelPapa: reviewAnnabelPapaImage,
  brombeerPapa: reviewBrombeerPapaImage,
  sarahKoala: reviewSarahKoalaImage,
  svenjaPapa: reviewSvenjaPapaImage,
};
const processIcons = [bookOpenIcon, penLineIcon, giftIcon];
const homeHref = currentLocale === 'de' ? '/' : '/en/';
const businessHref = currentLocale === 'de' ? '/fuer-unternehmen/' : '/en/for-business/';
const reviewColumns: Array<typeof content.reviews.items> = [[], [], []];
content.reviews.items.forEach((review, index) => {
  reviewColumns[index % reviewColumns.length].push(review);
});
const bestsellerProducts = [
  {
    image: bestseller1Image,
    href:
      'https://wunderweltkidsde.etsy.com/listing/4557897004?utm_source=website&utm_medium=referral&utm_campaign=bestseller&utm_content=produkt-1',
  },
  {
    image: bestseller2Image,
    href:
      'https://wunderweltkidsde.etsy.com/listing/4558200497?utm_source=website&utm_medium=referral&utm_campaign=bestseller&utm_content=produkt-2',
  },
  {
    image: bestseller3Image,
    href:
      'https://wunderweltkidsde.etsy.com/listing/4484785771?utm_source=website&utm_medium=referral&utm_campaign=bestseller&utm_content=produkt-3',
  },
  {
    image: bestseller4Image,
    href:
      'https://wunderweltkidsde.etsy.com/listing/4464543440?utm_source=website&utm_medium=referral&utm_campaign=bestseller&utm_content=produkt-4',
  },
  {
    image: bestseller5Image,
    href:
      'https://wunderweltkidsde.etsy.com/listing/4491044809?utm_source=website&utm_medium=referral&utm_campaign=bestseller&utm_content=produkt-5',
  },
];
---

<main class="landing-shell">
  <section class="hero-section">
    <SiteHeader
      currentLocale={currentLocale}
      alternateLocaleHref={alternateLocaleHref}
      businessHref={businessHref}
      logoHref={homeHref}
      currentPage="home"
    />

    <div class="hero-grid">
      <div class="hero-copy">
        <h1>{content.hero.headline}</h1>
        <p>{content.hero.subheadline}</p>
        <a class="button-link" href={shopHref}>{content.hero.cta}</a>
      </div>

      <div class="hero-art">
        <div class="hero-visual">
          <div class="hero-image-frame">
            <Picture
              src={heroImage}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 420, 560, 720, 900]}
              sizes="(max-width: 760px) calc(100vw - 44px), (max-width: 1160px) 36vw, 420px"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              quality={68}
              class="hero-family-image"
              alt={content.hero.imageAlt}
            />
          </div>
          <video
            class="hero-character-preview"
            width="240"
            height="240"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            poster="/media/hero-characters-static.webp"
            aria-hidden="true"
          >
            <source
              src="/media/hero-characters.webm"
              type="video/webm"
              media="(prefers-reduced-motion: no-preference)"
            />
          </video>
        </div>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <Picture
      src={butterflyImage}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[48, 62, 82, 96, 124, 164]}
      sizes="(max-width: 760px) 62px, 82px"
      quality={76}
      loading="lazy"
      decoding="async"
      class="notice-butterfly"
      alt=""
      aria-hidden="true"
    />
    <div class="notice-content">
      <a class="notice-review-link" href={reviewsHref} target="_blank" rel="noopener noreferrer">
        {content.reviews.summary}
      </a>
      <p>{content.notice.text}</p>
      <ol class="notice-steps" aria-label={content.process.heading}>
        {content.process.steps.map((step, index) => (
          <li>
            <span class="notice-step-icon" aria-hidden="true">
              <Fragment set:html={processIcons[index]} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bestsellers-section" aria-labelledby="bestsellers-heading">
    <div class="bestsellers-inner">
      <div class="bestsellers-header">
        <h2 id="bestsellers-heading">{content.bestsellers.heading}</h2>
      </div>

      <div class="bestsellers-grid">
        {bestsellerProducts.map((product, index) => (
          <a
            class="bestseller-link"
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={content.bestsellers.items[index].linkLabel}
          >
            <Picture
              src={product.image}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 760px) calc(100vw - 44px), (max-width: 1020px) calc(50vw - 48px), 200px"
              quality={72}
              loading="lazy"
              decoding="async"
              class="bestseller-image"
              alt={content.bestsellers.items[index].imageAlt}
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="reviews-section" aria-labelledby="reviews-heading">
    <div class="reviews-inner">
      <div class="reviews-header">
        <p class="reviews-kicker">{content.reviews.summary}</p>
        <h2 id="reviews-heading">{content.reviews.heading}</h2>
        <p>{content.reviews.subheading}</p>
      </div>

      <div class="review-scroller" aria-label={content.reviews.heading} tabindex="0">
        <div class="review-masonry">
          {reviewColumns.map((column) => (
            <div class="review-column">
              {column.map((review) => (
                <article class="review-card">
                  {review.imageKey && (
                    <Picture
                      class="review-image"
                      src={reviewImages[review.imageKey]}
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[240, 300]}
                      sizes="(max-width: 760px) calc(100vw - 88px), 290px"
                      quality={65}
                      alt={review.imageAlt ?? ''}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="review-stars" aria-label={reviewStarsLabel}>★★★★★</div>
                  <blockquote>“{review.quote}”</blockquote>
                  <footer>
                    <strong>{review.author}</strong>
                    <span>{review.date} · {review.context}</span>
                    <span>{review.source}</span>
                  </footer>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>

      <a class="reviews-link" href={reviewsHref} target="_blank" rel="noopener noreferrer">
        {content.reviews.cta}
      </a>
    </div>
  </section>

  <footer class="site-footer">
    <Picture
      src={twigImage}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[105, 142, 210, 284]}
      sizes="(max-width: 760px) 105px, 142px"
      quality={60}
      loading="lazy"
      decoding="async"
      class="footer-twig"
      alt=""
      aria-hidden="true"
    />
    <div class="footer-center">
      <Picture
        src={logoShort}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[56, 112]}
        sizes="56px"
        quality={65}
        loading="lazy"
        decoding="async"
        class="footer-logo"
        alt="WunderweltDE"
      />
      <p>{content.footer}</p>
      <nav class="footer-links" aria-label="Footer">
        <div class="footer-legal-links">
          <a href="/impressum/" target="_blank" rel="noopener noreferrer">Impressum</a>
          <span aria-hidden="true">|</span>
          <a href="/datenschutz/" target="_blank" rel="noopener noreferrer">Datenschutz</a>
        </div>
        <a class="footer-social-link" href={instagramHref} target="_blank" rel="noopener noreferrer" aria-label="Wunderwelt Kids auf Instagram">
          <Fragment set:html={instagramIcon} />
        </a>
      </nav>
    </div>
    <Picture
      src={butterflyImage}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[38, 48, 76, 96]}
      sizes="(max-width: 760px) 38px, 48px"
      quality={76}
      loading="lazy"
      decoding="async"
      class="footer-butterfly"
      alt=""
      aria-hidden="true"
    />
  </footer>
</main>

<style>
  :global(body) {
    margin: 0;
    background: #fffdf8;
    color: #284b70;
    font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .landing-shell {
    min-height: 100dvh;
    overflow: visible;
    background: #fffdf8;
  }

  .hero-section {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding: 30px clamp(22px, 6vw, 70px) 0;
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: clamp(38px, 7vw, 86px);
    align-items: center;
    min-height: min(620px, calc(100dvh - 92px));
    padding: 42px 0 58px;
  }

  .hero-copy {
    max-width: 510px;
  }

  h1 {
    margin: 0 0 22px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(2.3rem, 4vw, 2.85rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .hero-copy p {
    max-width: 48ch;
    margin: 0 0 28px;
    color: #111827;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.6;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 49px;
    box-sizing: border-box;
    padding: 0 25px;
    border-radius: 999px;
    background: #4f7773;
    color: #fffdf8;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
    white-space: nowrap;
  }

  .button-link:hover {
    background: #284b70;
    transform: translateY(-1px);
  }

  .button-link:focus-visible {
    background: #284b70;
    outline: 3px solid #78a49f;
    outline-offset: 3px;
    transform: translateY(-1px);
  }

  .button-link:active {
    transform: scale(0.98);
  }

  .hero-art {
    position: relative;
    display: grid;
    justify-items: end;
    align-items: center;
  }

  .hero-visual {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
  }

  .hero-image-frame {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #eef4fb;
    box-shadow: 0 22px 55px rgba(40, 75, 112, 0.13);
  }

  .hero-family-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-character-preview {
    position: absolute;
    z-index: 2;
    right: -36px;
    bottom: -26px;
    display: block;
    width: clamp(112px, 12vw, 142px);
    aspect-ratio: 1;
    pointer-events: none;
    filter: drop-shadow(0 12px 18px rgba(40, 75, 112, 0.15));
  }

  .bestsellers-section {
    padding: clamp(48px, 7vw, 76px) clamp(22px, 5vw, 40px);
    background: #fffdf8;
  }

  .bestsellers-inner {
    width: min(100%, 900px);
    margin-inline: auto;
  }

  .bestsellers-header {
    width: min(100%, 620px);
    margin: 0 auto 30px;
    text-align: center;
  }

  .bestsellers-header h2 {
    margin: 0;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(1.55rem, 3vw, 2rem);
    line-height: 1.18;
  }

  .bestsellers-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 14px);
  }

  .bestseller-link {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(40, 75, 112, 0.12);
    border-radius: 8px;
    background: #eef4fb;
    box-shadow: 0 14px 34px rgba(40, 75, 112, 0.08);
    text-decoration: none;
    transition: box-shadow 160ms ease, transform 160ms ease;
  }

  .bestseller-link:hover,
  .bestseller-link:focus-visible {
    box-shadow: 0 18px 38px rgba(40, 75, 112, 0.16);
    outline: 3px solid #78a49f;
    outline-offset: 4px;
    transform: translateY(-3px);
  }

  .bestseller-link:active {
    transform: scale(0.98);
  }

  .bestseller-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .reviews-section {
    position: relative;
    padding: clamp(48px, 7vw, 76px) clamp(22px, 5vw, 40px);
    background: #fff9ed;
  }

  .reviews-inner {
    width: min(100%, 1040px);
    margin-inline: auto;
    text-align: center;
  }

  .reviews-header {
    width: min(100%, 620px);
    margin-inline: auto;
  }

  .reviews-kicker {
    margin: 0 0 9px;
    color: #b6782f;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .reviews-header h2 {
    margin: 0 0 10px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(1.55rem, 3vw, 2rem);
    line-height: 1.18;
  }

  .reviews-header p:not(.reviews-kicker) {
    margin: 0;
    color: #111827;
    font-size: 1rem;
    line-height: 1.5;
  }

  .review-scroller {
    max-height: clamp(580px, 76vh, 780px);
    margin-top: 30px;
    padding: 4px 14px 16px 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-block: contain;
    text-align: left;
    scrollbar-color: rgba(40, 75, 112, 0.38) rgba(40, 75, 112, 0.08);
  }

  .review-masonry {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 18px;
  }

  .review-column {
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .review-scroller:focus-visible {
    outline: 3px solid #78a49f;
    outline-offset: 6px;
  }

  .review-card {
    display: inline-block;
    width: 100%;
    margin: 0;
    padding: 22px;
    border: 1px solid rgba(40, 75, 112, 0.12);
    border-radius: 8px;
    background: #fffdf8;
    box-shadow: 0 14px 34px rgba(40, 75, 112, 0.08);
    box-sizing: border-box;
    break-inside: avoid;
  }

  .review-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    margin-bottom: 18px;
    border-radius: 6px;
    object-fit: cover;
    object-position: center;
    background: #eef4fb;
  }

  .review-stars {
    color: #c7832f;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .review-card blockquote {
    margin: 16px 0 20px;
    color: #111827;
    font-size: 1rem;
    line-height: 1.55;
  }

  .review-card footer {
    display: grid;
    gap: 3px;
    color: #496583;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .review-card strong {
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.96rem;
  }

  .reviews-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 43px;
    margin-top: 28px;
    padding: 0 22px;
    border-radius: 999px;
    background: #284b70;
    color: #fffdf8;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .reviews-link:hover,
  .reviews-link:focus-visible {
    background: #78a49f;
    outline: 3px solid #78a49f;
    outline-offset: 3px;
    transform: translateY(-1px);
  }

  .notice-section {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 386px;
    padding: 54px 24px 58px;
    background: #eef4fb;
  }

  .notice-butterfly {
    position: absolute;
    left: clamp(42px, 13vw, 126px);
    top: 30px;
    width: 82px;
    height: auto;
    transform: scaleX(-1);
  }

  .notice-content {
    width: min(100%, 1040px);
    text-align: center;
  }

  .notice-review-link {
    display: inline-flex;
    margin-bottom: 17px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .notice-review-link:hover,
  .notice-review-link:focus-visible {
    color: #4f7773;
    outline: 3px solid #78a49f;
    outline-offset: 4px;
  }

  .notice-content > p {
    margin: 0 auto 29px;
    width: min(100%, 560px);
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    line-height: 1.45;
  }

  .notice-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 6vw, 70px);
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }

  .notice-steps li {
    display: grid;
    justify-items: center;
    min-width: 0;
    text-align: center;
  }

  .notice-step-icon {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 17px;
    border: 1px solid rgba(40, 75, 112, 0.12);
    border-radius: 999px;
    background: #fffdf8;
    color: #78a49f;
    box-shadow: 0 12px 28px rgba(40, 75, 112, 0.06);
  }

  .notice-step-icon :global(svg) {
    width: 25px;
    height: 25px;
    stroke-width: 1.9;
  }

  .notice-steps h3 {
    margin: 0 0 6px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .notice-steps p {
    width: min(100%, 280px);
    margin: 0;
    color: #111827;
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .site-footer {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 193px;
    padding: 36px 24px 28px;
  }

  .footer-center {
    text-align: center;
  }

  .footer-logo {
    display: block;
    width: 56px;
    height: auto;
    margin: 0 auto 12px;
  }

  .footer-center p {
    margin: 0;
    color: #284b70;
    font-size: 1rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .footer-legal-links {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease, transform 160ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #78a49f;
    outline: 3px solid #78a49f;
    outline-offset: 4px;
    transform: translateY(-1px);
  }

  .footer-social-link {
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(40, 75, 112, 0.24);
    border-radius: 999px;
    background: #fffdf8;
  }

  .footer-social-link :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
