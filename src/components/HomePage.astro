---
import type { HomeContent } from '../data/homeContent';
import heroImage from '../../assets/img_hero.png';
import butterflyImage from '../../assets/dec_butterfly.png';
import twigImage from '../../assets/dec_twig.png';
import reviewAnnabelPapaImage from '../assets/review-annabel-papa.jpg';
import reviewBrombeerPapaImage from '../assets/review-brombeer-papa.jpg';
import reviewSarahKoalaImage from '../assets/review-sarah-koala.jpg';
import reviewSvenjaPapaImage from '../assets/review-svenja-papa.jpg';
import logoLong from '../../assets/Etsy logo (2)/logo_long.png';
import logoShort from '../../assets/Etsy logo (2)/logo_short.png';
import bookOpenIcon from 'lucide-static/icons/book-open.svg?raw';
import giftIcon from 'lucide-static/icons/gift.svg?raw';
import instagramIcon from 'lucide-static/icons/instagram.svg?raw';
import penLineIcon from 'lucide-static/icons/pen-line.svg?raw';

interface Props {
  content: HomeContent;
  currentLocale: 'en' | 'de';
  alternateLocaleHref: string;
}

const { content, currentLocale, alternateLocaleHref } = Astro.props;
const shopHref = 'https://www.etsy.com/de/shop/WunderweltKidsDE';
const reviewsHref = 'https://www.etsy.com/de/shop/WunderweltKidsDE#reviews';
const instagramHref = 'https://www.instagram.com/wunderwelt.kids/';
const reviewStarsLabel = currentLocale === 'de' ? '5 von 5 Sternen' : '5 out of 5 stars';
const reviewImages = {
  annabelPapa: reviewAnnabelPapaImage,
  brombeerPapa: reviewBrombeerPapaImage,
  sarahKoala: reviewSarahKoalaImage,
  svenjaPapa: reviewSvenjaPapaImage,
};
const processIcons = [bookOpenIcon, penLineIcon, giftIcon];
const reviewColumns: Array<typeof content.reviews.items> = [[], [], []];
content.reviews.items.forEach((review, index) => {
  reviewColumns[index % reviewColumns.length].push(review);
});
---

<main class="landing-shell">
  <section class="hero-section">
    <header class="site-header">
      <a href={shopHref} aria-label="WunderweltDE Etsy Shop" class="logo-link">
        <img src={logoLong.src} width="144" height="144" alt="WunderweltDE" />
      </a>
      <a href={alternateLocaleHref} class="language-link">
        {currentLocale === 'de' ? 'EN' : 'DE'}
      </a>
    </header>

    <div class="hero-grid">
      <div class="hero-copy">
        <h1>{content.hero.headline}</h1>
        <p>{content.hero.subheadline}</p>
        <a class="button-link" href={shopHref}>{content.hero.cta}</a>
      </div>

      <div class="hero-art">
        <div class="hero-visual" aria-hidden="true">
          <img class="hero-books" src={heroImage.src} width={heroImage.width} height={heroImage.height} alt="" />
        </div>
        <a class="hero-review-link" href={reviewsHref} target="_blank" rel="noopener noreferrer">
          {content.reviews.summary}
        </a>
      </div>
    </div>
  </section>

  <section class="notice-section">
    <img class="notice-butterfly" src={butterflyImage.src} width={butterflyImage.width} height={butterflyImage.height} alt="" aria-hidden="true" />
    <div class="notice-content">
      <p>{content.notice.text}</p>
      <ol class="notice-steps" aria-label={content.process.heading}>
        {content.process.steps.map((step, index) => (
          <li>
            <span class="notice-step-icon" aria-hidden="true">
              <Fragment set:html={processIcons[index]} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <a class="button-link" href={shopHref}>{content.notice.cta}</a>
    </div>
  </section>

  <section class="reviews-section" aria-labelledby="reviews-heading">
    <div class="reviews-inner">
      <div class="reviews-header">
        <p class="reviews-kicker">{content.reviews.summary}</p>
        <h2 id="reviews-heading">{content.reviews.heading}</h2>
        <p>{content.reviews.subheading}</p>
      </div>

      <div class="review-scroller" aria-label={content.reviews.heading} tabindex="0">
        <div class="review-masonry">
          {reviewColumns.map((column) => (
            <div class="review-column">
              {column.map((review) => (
                <article class="review-card">
                  {review.imageKey && (
                    <img
                      class="review-image"
                      src={reviewImages[review.imageKey].src}
                      width={reviewImages[review.imageKey].width}
                      height={reviewImages[review.imageKey].height}
                      alt={review.imageAlt}
                      loading="lazy"
                    />
                  )}
                  <div class="review-stars" aria-label={reviewStarsLabel}>★★★★★</div>
                  <blockquote>“{review.quote}”</blockquote>
                  <footer>
                    <strong>{review.author}</strong>
                    <span>{review.date} · {review.context}</span>
                    <span>{review.source}</span>
                  </footer>
                </article>
              ))}
            </div>
          ))}
        </div>
      </div>

      <a class="reviews-link" href={reviewsHref} target="_blank" rel="noopener noreferrer">
        {content.reviews.cta}
      </a>
    </div>
  </section>

  <footer class="site-footer">
    <img class="footer-twig" src={twigImage.src} width={twigImage.width} height={twigImage.height} alt="" aria-hidden="true" />
    <div class="footer-center">
      <img class="footer-logo" src={logoShort.src} width="74" height="74" alt="WunderweltDE" />
      <p>{content.footer}</p>
      <nav class="footer-links" aria-label="Footer">
        <div class="footer-legal-links">
          <a href="/impressum/" target="_blank" rel="noopener noreferrer">Impressum</a>
          <span aria-hidden="true">|</span>
          <a href="/datenschutz/" target="_blank" rel="noopener noreferrer">Datenschutz</a>
        </div>
        <a class="footer-social-link" href={instagramHref} target="_blank" rel="noopener noreferrer" aria-label="Wunderwelt Kids auf Instagram">
          <Fragment set:html={instagramIcon} />
        </a>
      </nav>
    </div>
    <img class="footer-butterfly" src={butterflyImage.src} width={butterflyImage.width} height={butterflyImage.height} alt="" aria-hidden="true" />
  </footer>
</main>

<style>
  :global(body) {
    margin: 0;
    background: #fffdf8;
    color: #284b70;
    font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .landing-shell {
    min-height: 100vh;
    overflow: visible;
    background: #fffdf8;
  }

  .hero-section {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 1120px;
    min-height: 502px;
    margin-inline: auto;
    padding: 30px clamp(22px, 8vw, 86px) 0;
    overflow: hidden;
  }

  .site-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    width: 151px;
  }

  .logo-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .language-link {
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(280px, 390px) minmax(320px, 1fr);
    gap: clamp(32px, 10vw, 122px);
    align-items: center;
    margin-top: 40px;
  }

  .hero-copy {
    max-width: 380px;
  }

  h1 {
    margin: 0 0 20px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(2rem, 3.1vw, 2.22rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .hero-copy p {
    margin: 0 0 25px;
    color: #111827;
    font-size: clamp(0.96rem, 1.7vw, 1.08rem);
    line-height: 1.45;
  }

  .button-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 47px;
    padding: 0 26px;
    border-radius: 999px;
    background: #78a49f;
    color: #fffdf8;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
    white-space: nowrap;
  }

  .button-link:hover,
  .button-link:focus-visible {
    background: #284b70;
    outline: 3px solid #ffd9e5;
    outline-offset: 3px;
    transform: translateY(-1px);
  }

  .hero-art {
    position: relative;
    display: grid;
    justify-items: center;
    min-height: 330px;
  }

  .hero-visual {
    position: relative;
    width: 100%;
  }

  .hero-books {
    position: relative;
    z-index: 1;
    display: block;
    width: min(350px, 80%);
    height: auto;
    margin: 0 auto;
  }

  .hero-review-link {
    display: block;
    width: min(350px, 80%);
    margin-top: 12px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    text-decoration: none;
    justify-self: center;
  }

  .hero-review-link:hover,
  .hero-review-link:focus-visible {
    color: #78a49f;
    outline: 3px solid #ffd9e5;
    outline-offset: 4px;
  }

  .reviews-section {
    position: relative;
    padding: clamp(48px, 7vw, 76px) clamp(22px, 5vw, 40px);
    background: #fff9ed;
  }

  .reviews-inner {
    width: min(100%, 1040px);
    margin-inline: auto;
    text-align: center;
  }

  .reviews-header {
    width: min(100%, 620px);
    margin-inline: auto;
  }

  .reviews-kicker {
    margin: 0 0 9px;
    color: #b6782f;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .reviews-header h2 {
    margin: 0 0 10px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(1.55rem, 3vw, 2rem);
    line-height: 1.18;
  }

  .reviews-header p:not(.reviews-kicker) {
    margin: 0;
    color: #111827;
    font-size: 1rem;
    line-height: 1.5;
  }

  .review-scroller {
    max-height: clamp(580px, 76vh, 780px);
    margin-top: 30px;
    padding: 4px 14px 16px 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-block: contain;
    text-align: left;
    scrollbar-color: rgba(40, 75, 112, 0.38) rgba(40, 75, 112, 0.08);
  }

  .review-masonry {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 18px;
  }

  .review-column {
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .review-scroller:focus-visible {
    outline: 3px solid #ffd9e5;
    outline-offset: 6px;
  }

  .review-card {
    display: inline-block;
    width: 100%;
    margin: 0;
    padding: 22px;
    border: 1px solid rgba(40, 75, 112, 0.12);
    border-radius: 8px;
    background: #fffdf8;
    box-shadow: 0 14px 34px rgba(40, 75, 112, 0.08);
    box-sizing: border-box;
    break-inside: avoid;
  }

  .review-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    margin-bottom: 18px;
    border-radius: 6px;
    object-fit: cover;
    object-position: center;
    background: #eef4fb;
  }

  .review-stars {
    color: #c7832f;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .review-card blockquote {
    margin: 16px 0 20px;
    color: #111827;
    font-size: 1rem;
    line-height: 1.55;
  }

  .review-card footer {
    display: grid;
    gap: 3px;
    color: #496583;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .review-card strong {
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.96rem;
  }

  .reviews-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 43px;
    margin-top: 28px;
    padding: 0 22px;
    border-radius: 999px;
    background: #284b70;
    color: #fffdf8;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .reviews-link:hover,
  .reviews-link:focus-visible {
    background: #78a49f;
    outline: 3px solid #ffd9e5;
    outline-offset: 3px;
    transform: translateY(-1px);
  }

  .notice-section {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 386px;
    padding: 54px 24px 58px;
    background: #eef4fb;
  }

  .notice-butterfly {
    position: absolute;
    left: clamp(42px, 13vw, 126px);
    top: 30px;
    width: 82px;
    height: auto;
    transform: scaleX(-1);
  }

  .notice-content {
    width: min(100%, 1040px);
    text-align: center;
  }

  .notice-content > p {
    margin: 0 auto 29px;
    width: min(100%, 560px);
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    line-height: 1.45;
  }

  .notice-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 6vw, 70px);
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }

  .notice-steps li {
    display: grid;
    justify-items: center;
    min-width: 0;
    text-align: center;
  }

  .notice-step-icon {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 17px;
    border: 1px solid rgba(40, 75, 112, 0.12);
    border-radius: 999px;
    background: #fffdf8;
    color: #78a49f;
    box-shadow: 0 12px 28px rgba(40, 75, 112, 0.06);
  }

  .notice-step-icon :global(svg) {
    width: 25px;
    height: 25px;
    stroke-width: 1.9;
  }

  .notice-steps h3 {
    margin: 0 0 6px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .notice-steps p {
    width: min(100%, 280px);
    margin: 0;
    color: #111827;
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .site-footer {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 193px;
    padding: 36px 24px 28px;
  }

  .footer-center {
    text-align: center;
  }

  .footer-logo {
    display: block;
    width: 56px;
    height: auto;
    margin: 0 auto 12px;
  }

  .footer-center p {
    margin: 0;
    color: #284b70;
    font-size: 1rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    color: #284b70;
    font-family: 'Andika', system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .footer-legal-links {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease, transform 160ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: #78a49f;
    outline: 3px solid #ffd9e5;
    outline-offset: 4px;
    transform: translateY(-1px);
  }

  .footer-social-link {
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(40, 75, 112, 0.24);
    border-radius: 999px;
    background: #fffdf8;
  }

  .footer-social-link :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  .footer-twig {
    position: absolute;
    left: -18px;
    bottom: -18px;
    width: 142px;
    height: auto;
  }

  .footer-butterfly {
    position: absolute;
    right: clamp(40px, 9vw, 116px);
    top: 56px;
    width: 48px;
    height: auto;
  }

  @media (max-width: 760px) {
    .hero-section {
      min-height: auto;
      padding: 24px 22px 0;
    }

    .site-header {
      height: 48px;
    }

    .logo-link {
      width: 139px;
    }

    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: 38px;
      text-align: left;
    }

    .hero-copy {
      max-width: 100%;
    }

    .hero-copy p {
      max-width: 32rem;
    }

    .hero-art {
      width: 100%;
      min-height: 235px;
    }

    .hero-books {
      width: min(330px, 88%);
    }

    .hero-review-link {
      width: min(330px, 88%);
      margin-top: 10px;
    }

    .notice-section {
      min-height: auto;
      padding: 70px 22px 50px;
    }

    .notice-butterfly {
      left: 22px;
      top: 18px;
      width: 62px;
    }

    .notice-content {
      text-align: left;
    }

    .notice-content > p {
      margin-inline: 0;
    }

    .notice-steps {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 30px;
    }

    .notice-steps li {
      grid-template-columns: auto 1fr;
      gap: 14px;
      justify-items: start;
      text-align: left;
    }

    .notice-step-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 0;
    }

    .notice-step-icon :global(svg) {
      width: 22px;
      height: 22px;
    }

    .notice-steps p {
      width: auto;
    }

    .button-link {
      width: fit-content;
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }

    .reviews-section {
      padding: 46px 22px;
    }

    .reviews-inner {
      text-align: left;
    }

    .reviews-header {
      margin-inline: 0;
    }

    .review-scroller {
      max-height: min(70vh, 660px);
      margin-top: 24px;
      padding-right: 10px;
    }

    .review-masonry {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .review-column {
      gap: 14px;
    }

    .review-card {
      padding: 20px;
    }

    .reviews-link {
      width: fit-content;
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }

    .footer-twig {
      width: 105px;
    }

    .footer-butterfly {
      right: 22px;
      top: 34px;
      width: 38px;
    }
  }
</style>
